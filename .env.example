# Your FacePing sandbox key: app.faceping.ai, Developers, Sandbox keys, Create sandbox key.
# Copy this file to .env.local (ignored by git) and paste your key.
VITE_FACEPING_SANDBOX_KEY=fp_test_...

# To run as a check-in device for your practice list instead (see "Try it as a check-in device" in the README), set
# the device token from the list's Devices tab and the personId you enrolled on the list. A token wins over the key.
# VITE_FACEPING_DEVICE_TOKEN=fpd_...
# VITE_FACEPING_PERSON_ID=ACME-000123
